# ============================================
# NFE-JOALHERIAS - Variaveis de Ambiente
# ============================================
# Copie para .env e preencha com seus dados

# --- Servidor ---
PORT=3000
NODE_ENV=production
API_KEY=troque-por-uma-chave-forte-aleatoria

# --- Odoo (fiscal-cloud-joalherias.odoo.com) ---
ODOO_ENABLED=1
ODOO_URL=https://fiscal-cloud-joalherias.odoo.com
ODOO_DB=fiscal-cloud-joalherias
ODOO_USER=marcus@nytro.com.br
ODOO_API_KEY=coloque-sua-api-key-do-odoo-aqui
ODOO_POLLING_MS=20000

# --- Firebase (cofre do certificado A1 + logo) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_CERT_COLLECTION=certificados
FIREBASE_CERT_DOC_ID=joalheria-a1

# --- NF-e (SEFAZ - emissao propria) ---
NFE_EMISSAO_MODO=proprio
NFE_UF=PR
NFE_TP_AMB=2
NFE_CERT_DIR=/var/data
NFE_CERT_KEK=chave-simetrica-forte-para-cifrar-senha-em-disco
NFE_DANFE_PROVIDER=local
NFE_TLS_INSECURE=0
NFE_STATUS_ON_ERROR=erro

# --- Setor Joalheiro (parametros default) ---
JOALHERIA_REGIME_TRIBUTARIO=simples_nacional
JOALHERIA_OURO_CODIGO_NCM=71131900
JOALHERIA_MOEDA_REF=BRL

# --- Logs ---
LOG_LEVEL=info
